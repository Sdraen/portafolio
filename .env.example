# Crea una propiedad web en Google Analytics y pega aquí el ID con formato G-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Datos públicos del widget y del Worker de Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CONTACT_ENDPOINT=

# TURNSTILE_SECRET_KEY y WEB3FORMS_ACCESS_KEY se guardan como secretos del Worker,
# nunca como variables NEXT_PUBLIC ni dentro de este archivo.
